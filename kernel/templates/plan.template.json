{
  "_template": "plan.template.json",
  "_usage": "复制成 plan.json 后逐项填写。填完跑 governance.validate_plan(plan)：返回空列表才算可冻结。⛔ 不要保留 _usage/_template 这些下划线键。",
  "id": "<plan-id>",
  "goal": "<这一轮要回答的一个问题>",
  "hypothesis": {
    "id": "H1",
    "text": "<可被否掉的一句话：什么观察会让它错>"
  },
  "change_set": [
    {
      "id": "c1",
      "description": "<改了什么（不是「想让它变好」）>",
      "hypothesis_id": "H1"
    }
  ],
  "criteria": {
    "mode": "exploratory",
    "metric": "<观察什么>",
    "observation": "<支持、反驳、未看到分别是什么观察>",
    "interpretation_boundary": "<本次观察能解释什么、不能外推什么>",
    "conditions": "<装置、样本、预算和比较前提>"
  },
  "baseline": {
    "label": "<这一轮对照的是谁>",
    "fingerprint": "<对照件的内容指纹>"
  },
  "case_sets": {
    "target": [
      "<产生那个量的题>"
    ],
    "regression": [
      "<历史已通过、必须留着的题>",
      "<可选：其它回归题>"
    ],
    "control": []
  },
  "previous_passes": [
    "<历史已通过、必须留着的题>"
  ],
  "branches": {
    "support": {
      "action": "<支撑时下一步做什么>",
      "interpretation": "<这一支能说明什么>"
    },
    "contradict": {
      "action": "<反驳时下一步做什么>",
      "interpretation": "<这一支能说明什么>"
    },
    "inconclusive": {
      "action": "<判不了时下一步做什么（含跑不完/装置失败）>",
      "interpretation": "<这一支不能说明什么>"
    }
  },
  "budget": {
    "max_cost_units": 0,
    "max_seconds": 1
  },
  "input_files": [
    "<仓库内相对路径>"
  ],
  "notes": "<叙述字段：改它不会触发重新审计>"
}
